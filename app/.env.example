# ==============================================================================
# SPMIS Frontend Environment Variables (Browser / Vite Runtime)
# ==============================================================================
# Copy this file to `app/.env.local` for local development.
#
# SECURITY WARNING:
# Every variable prefixed with `VITE_` is bundled into the public browser client.
# NEVER place server-only secrets (`GEMINI_API_KEY`, `SUPABASE_SERVICE_ROLE_KEY`,
# or Google OAuth client secrets) in this file.
# ==============================================================================

# Base URL for the API / Supabase project:
# - Prism Mock Server (M2 / M4 default): http://localhost:4010
# - Local Supabase CLI (M3 / M5):        http://127.0.0.1:54321
# - Production Supabase Project:         https://<project-ref>.supabase.co
VITE_SUPABASE_URL=http://localhost:4010

# Public Supabase anonymous / publishable key (safe for browser use with RLS enabled):
VITE_SUPABASE_ANON_KEY=mock-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=mock-anon-key
