# ==============================================================================
# SPMIS Frontend Environment Variables (Browser / Vite Runtime)
# ==============================================================================
# Setup: Copy this file to `app/.env.local` for local development.
# Tip: Restart the Vite dev server (`npm --prefix app run dev`) after changes.
#
# SECURITY WARNING:
# Every variable prefixed with `VITE_` is compiled into the public browser bundle.
# NEVER place server-only secrets (`GEMINI_API_KEY`, `SUPABASE_SERVICE_ROLE_KEY`,
# `sb_secret_*`, or Google OAuth client secrets) in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Auth Target URL (Pick ONE active mode; comment out the others)
# ------------------------------------------------------------------------------
# - Mode A — Prism Mock Server (M2 / M4 UI dev before M3 backend is pushed):
VITE_SUPABASE_URL=http://localhost:4010
# - Mode B — Local Supabase CLI (`npx supabase start`):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# - Mode C — Hosted Cloud Supabase Project (Dashboard -> Settings -> Data API):
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# ------------------------------------------------------------------------------
# 2. Public Client API Keys (Safe for browser use; protected by RLS)
# ------------------------------------------------------------------------------
# - For Prism Mock (Mode A), keep both set to `mock-anon-key`.
# - For Local Supabase (Mode B), paste the `anon key` printed by `supabase status`.
# - For Cloud Supabase (Mode C), paste your Legacy `anon` key and `sb_publishable_*`
#   key from Supabase Dashboard -> Project Settings -> API Keys.
#   (`app/src/lib/supabase.ts` checks VITE_SUPABASE_PUBLISHABLE_KEY first, then ANON.)
VITE_SUPABASE_ANON_KEY=mock-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=mock-anon-key

# ------------------------------------------------------------------------------
# 3. OAuth Redirect Origin
# ------------------------------------------------------------------------------
# Used by Supabase Auth to build Google Sign-In callback redirects:
# - Local Vite server: http://localhost:5173
# - Production (Vercel): https://<your-app-domain>
VITE_SITE_URL=http://localhost:5173
