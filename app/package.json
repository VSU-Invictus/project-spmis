{
  "name": "spmis-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "contract:lint": "npx --yes @redocly/cli@2.71.0 lint ../contract/openapi.yaml --config ../contract/redocly.yaml",
    "contract:docs": "redocly build-docs ../contract/openapi.yaml --config ../contract/redocly.yaml --output public/docs/index.html",
    "contract:gen": "npx --yes openapi-typescript@7.13.0 ../contract/openapi.yaml --default-non-nullable=false -o ../contract/generated/schema.d.ts",
    "contract:check": "npm run contract:lint && node ../contract/check-generated.mjs",
    "mock:server": "prism mock ../contract/openapi.yaml --port 4010 --cors"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "openapi-fetch": "^0.14.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@stoplight/prism-cli": "^5.14.0",
    "@redocly/cli": "2.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
