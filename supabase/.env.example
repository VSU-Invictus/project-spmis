# ==============================================================================
# SPMIS Backend & Edge Functions Environment Variables (Server-Only Runtime)
# ==============================================================================
# Copy this file to `supabase/.env` for local Supabase CLI & Edge Functions
# (`npx supabase start` / `npx supabase functions serve --env-file supabase/.env`).
# For cloud deployment, set secrets with:
#   npx supabase secrets set --env-file supabase/.env
#
# SECURITY WARNING:
# NEVER commit `supabase/.env` to version control or expose these keys to `app/`.
# ==============================================================================

# Google AI Studio — Gemini API Key (used strictly by `reviews` and `chat` Edge Functions)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud OAuth 2.0 Credentials (used by Supabase Auth Google provider)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
