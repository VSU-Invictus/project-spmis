# ==============================================================================
# SPMIS Backend & Edge Functions Environment Variables (Server-Only Runtime)
# ==============================================================================
# Setup: Copy this file to `supabase/.env` for local Supabase CLI & Edge Functions:
#   - Local Auth / DB:        npx supabase start
#   - Local Edge Functions:   npx supabase functions serve --env-file supabase/.env
#   - Cloud Edge Secrets:     npx supabase secrets set --env-file supabase/.env
#
# Note: `SUPABASE_URL`, `SUPABASE_ANON_KEY`, and `SUPABASE_SERVICE_ROLE_KEY` are
# injected into Edge Functions automatically by the runtime — do not add them here.
#
# SECURITY WARNING:
# NEVER commit `supabase/.env` to version control or share it in public channels.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google AI Studio — Gemini API Key (Edge Functions Only)
# ------------------------------------------------------------------------------
# Used exclusively by `supabase/functions/reviews` (embeddings) and `chat`
# (RAG Q&A). Generated in Google AI Studio (https://aistudio.google.com/apikey).
# Note: Newer Google AI Studio keys start with `AQ.` (or legacy `AIza...`);
# authenticate via official SDK / `x-goog-api-key` rather than prefix checks.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 2. Google Cloud OAuth 2.0 Credentials (Supabase Auth Provider)
# ------------------------------------------------------------------------------
# Generated in Google Cloud Console -> Google Auth Platform -> Clients (Web app).
# Used locally via `env(GOOGLE_CLIENT_ID)` / `env(GOOGLE_CLIENT_SECRET)` in
# `supabase/config.toml` and in Cloud via Dashboard -> Auth -> Providers -> Google.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
